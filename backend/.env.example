# Copy to backend/.env and fill in.

# The only secret. If unset here, the pipeline's own loader falls back to
# ../../sop_generator/.env — but setting it here is the supported path.
OPENAI_API_KEY=

# Path to the read-only sop_generator repo.
# Default: <repo>/../sop_generator
# SOP_GENERATOR_PATH=/absolute/path/to/sop_generator

# Markdown file describing the 11-section SOP template the generator must follow.
# Default: <SOP_GENERATOR_PATH>/sop_template_guide.md
# SCHEMA_GUIDE_PATH=/absolute/path/to/sop_template_guide.md

# Where per-job inputs/outputs are written. Default: backend/runs
# RUNS_DIR=/absolute/path/to/runs
